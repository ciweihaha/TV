<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:padding="24dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="24dp"
        android:layout_weight="2"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.fongmi.android.tv.ui.custom.CustomMic
                android:id="@+id/mic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/keyboard"
                android:src="@drawable/ic_search_mic" />

            <com.fongmi.android.tv.ui.custom.CustomSearchView
                android:id="@+id/keyword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/search_keyword"
                android:imeOptions="actionDone"
                android:inputType="textCapWords|textAutoCorrect|textAutoComplete"
                android:letterSpacing="0.02"
                android:maxLength="255"
                android:nextFocusDown="@id/keyboard"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textCursorDrawable="@drawable/shape_cursor"
                android:textSize="24sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 键盘模式切换：拼音全键 / 拼音九键（笔画键盘已删除） -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/keyboardTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tabFull"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/selector_keyboard_tab"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="@string/keyboard_full"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tabNine"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/selector_keyboard_tab"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="@string/keyboard_nine"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 功能键：遥控 / 左移 / 右移 / 删除 / 搜索 / 切换输入法 / 切换站点 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/keyboardIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconRemote"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/selector_keyboard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scaleType="center"
                android:src="@drawable/ic_keyboard_remote" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconLeft"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/selector_keyboard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scaleType="center"
                android:src="@drawable/ic_keyboard_left" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconRight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/selector_keyboard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scaleType="center"
                android:src="@drawable/ic_keyboard_right" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/selector_keyboard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scaleType="center"
                android:src="@drawable/ic_keyboard_back" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/selector_keyboard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scaleType="center"
                android:src="@drawable/ic_keyboard_search" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconKeyboard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/selector_keyboard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scaleType="center"
                android:src="@drawable/ic_keyboard" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/selector_keyboard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scaleType="center"
                android:src="@drawable/ic_setting_home" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 拼写条：正在拼的拼音（全键一格字母串，九键为可切换的音节）；只在拼写时显示 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/composingBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:itemCount="3"
            tools:listitem="@layout/adapter_composing_syllable" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="20"
            tools:itemCount="54"
            tools:listitem="@layout/adapter_keyboard_text" />

        <!-- 底部：使用系统输入法 / 完成 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/keyboardBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/systemIme"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/selector_keyboard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="@string/keyboard_system"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/done"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:background="@drawable/selector_keyboard"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="@string/keyboard_done"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/recordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/search_record"
                    android:textColor="@color/white"
                    android:textSize="24sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recordRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    tools:itemCount="6"
                    tools:listitem="@layout/adapter_search_record" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/search_hot"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/wordRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                tools:itemCount="10"
                tools:listitem="@layout/adapter_search_word" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
