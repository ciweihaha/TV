<?xml version="1.0" encoding="utf-8"?>
<!-- 百度输入法电视版搜索屏：底部灰色键盘面板 + 右栏实时出结果。
     面板顶部页签只有拼音全键 / 拼音九键（没有笔画键盘）；候选栏在键盘上方，首选蓝底，
     遥控选词上屏去搜；全键 QWERTY 三行错列，空格在第三行中间；左列 分词 / ?12 / 中/英，
     右列 删除 / 完成（完成占两行高）；左下角 du 标志。英文模式没有候选栏，字母直输。
     2026-11-21：应用/游戏/影片三个死 tab 已去掉，右栏顶部改为“影视”范围说明（搜索只搜影视）。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_dangbei_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:padding="24dp">

    <!-- 左栏（约 35%）：搜索框 + 百度键盘面板 + 模式行 + 提示行 + 当前匹配 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="24dp"
        android:layout_weight="35"
        android:orientation="vertical">

        <!-- 搜索框：放大镜 + 已输字母 + 语音 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_keyboard_search" />

                <com.fongmi.android.tv.ui.custom.CustomSearchView
                    android:id="@+id/keyword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:background="@null"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/search_keyword"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords|textAutoCorrect|textAutoComplete"
                    android:letterSpacing="0.02"
                    android:maxLength="255"
                    android:nextFocusDown="@id/tabFull"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textCursorDrawable="@drawable/shape_cursor"
                    android:textSize="24sp" />

                <com.fongmi.android.tv.ui.custom.CustomMic
                    android:id="@+id/mic"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusDown="@id/tabFull"
                    android:src="@drawable/ic_search_mic" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/white_30" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 百度键盘面板（底部灰色）：页签 + 候选栏 + 键盘行（左列 / 键格 / 右列）+ du 标志。
             系统输入法模式下整个面板隐藏，只留模式行作切回入口。 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/kbPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/baidu_panel_gray"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 页签：拼音全键 / 拼音九键（没有笔画键盘） -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/kbTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tabFull"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/selector_keyboard_tab"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/keyboard_full"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tabNine"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/selector_keyboard_tab"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/keyboard_nine"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 候选栏：键盘上方，首选蓝底；中文模式有拼写且有建议时才显示，英文模式不显示 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/candidateBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/adapter_candidate" />

            <!-- 键盘行：左列（分词 / ?12 / 中/英）+ 键格 + 右列（删除 / 完成， 完成占两行高） -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/kbRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/segKey"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_keyboard_dangbei"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:text="@string/search_seg"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/symKey"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_keyboard_dangbei"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:text="?12"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/langKey"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_keyboard_dangbei"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:text="@string/search_lang_toggle"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- 全键 QWERTY 三行错列（20 列，半键为单位）/ 九键 3×4（3 列）/ 符号盘（20 列）共用 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/keyboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="20"
                    tools:itemCount="30"
                    tools:listitem="@layout/adapter_keyboard_text" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/delKey"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_keyboard_dangbei"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:text="@string/search_delete"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/doneKey"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:background="@drawable/selector_keyboard_dangbei"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:text="@string/keyboard_done"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 左下角 du 标志 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/duLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:text="du"
                    android:textColor="@color/baidu_blue"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 模式行：绿点“全键盘” / 蓝点“系统输入法”（系统输入法为逃生通道） -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/modeFull"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/selector_keyboard_dangbei"
                android:drawableStart="@drawable/shape_dot_green"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/search_mode_full"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/modeSystem"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/selector_keyboard_dangbei"
                android:drawableStart="@drawable/shape_dot_blue"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/search_mode_system"
                android:textColor="@color/white_60"
                android:textSize="16sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 提示行（第一行随中/英文模式切换，见 CustomKeyboard.toggleLang）+ 新键用法说明 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/hintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/search_hint_dangbei"
            android:textColor="@color/dangbei_hint"
            android:textSize="14sp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/search_hint_keys"
            android:textColor="@color/dangbei_hint"
            android:textSize="14sp" />

        <!-- 当前匹配：黄色拼音首字母（已输字母）+ 白色大号中文（首个建议标题） -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/matchLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/matchPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dangbei_pinyin_yellow"
                android:textSize="20sp"
                tools:text="T U S H U G U A N" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/matchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/white"
                android:textSize="28sp"
                tools:text="图书馆员" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 右栏（约 65%）：影视范围 + 结果数 + 结果列表 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="65"
        android:orientation="horizontal">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 顶部：搜索范围说明“影视”（搜索只搜影视）+ 右上角结果数。
                 2026-11-21 之前这里是应用/游戏/影片三个 tab：应用是摆设（实际就是全部结果）、
                 游戏/影片写死禁用点不进，用户以为搜错了范围；整个去掉，改成“影视”。 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/scopeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_scope_movie"
                    android:textColor="@color/white"
                    android:textSize="24sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/resultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="相关搜索结果：1个" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/recordLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:text="@string/search_record"
                            android:textColor="@color/white"
                            android:textSize="24sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recordRecycler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-6dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:overScrollMode="never"
                            tools:itemCount="6"
                            tools:listitem="@layout/adapter_search_record" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/word"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="@string/search_hot"
                        android:textColor="@color/white"
                        android:textSize="24sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/wordRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-6dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        tools:itemCount="10"
                        tools:listitem="@layout/adapter_search_word" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
