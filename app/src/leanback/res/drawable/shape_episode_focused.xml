<?xml version="1.0" encoding="utf-8"?>
<!-- 选集按钮焦点态：黄色粗框（和源页签的选中黄框一样醒目，框更粗以便和“正在播”那集区分）。
     之前焦点态是 1.5dp 白框，在视频画面上几乎看不见；而且焦点落在条目根布局上、
     背景却画在里面的 TextView 上，焦点高亮根本不显示。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/black_40" />

    <corners android:radius="4dp" />

    <padding
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp"
        android:top="8dp" />

    <stroke
        android:width="2.5dp"
        android:color="@color/yellow_500" />

</shape>
